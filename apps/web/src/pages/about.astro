---
import BaseLayout from "../layouts/BaseLayout.astro";

const identity = {
  firstName: "Francis",
  country: "Philippines",
  occupation: "Software Engineer",
  hobbies: ["reading", "coding", "traveling"],
};
---

<BaseLayout title="About Me">
  <article class="about-page">
    <header class="about-header">
      <h1 class="page-title">About Me</h1>
      <p class="page-subtitle">
        {identity.occupation} based in the {identity.country}.
      </p>
    </header>

    <div class="about-content">
      <p>
        I build full-stack systems that turn product intent into reliable,
        intelligent software.
      </p>
      <p>
        I work across interfaces, APIs, data, and AI-powered workflows that
        connects user experience to the services, models, and systems that make
        it work.
      </p>
      <p>
        I specialize in making thoughtful trade-offs: choosing the right
        architecture and patterns today to ship value now while keeping the
        system secure, observable, and easy to evolve. I believe a modern
        application isn’t just fast to load; it’s designed to adapt, scale, and
        improve as both the product and the technology around it change.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    padding-top: 1rem;
  }

  .about-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 2.25rem;
  }

  .page-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .about-content {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .manifesto-quote {
    margin: 1.75rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-surface);
    border-radius: 0 8px 8px 0;
    font-style: normal;
  }

  .manifesto-author {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }
</style>
